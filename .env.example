# Database
DATABASE_URL=postgresql+asyncpg://vuzbot:secret@db:5432/vuzbot

# Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAABBBCCC
TELEGRAM_WEBHOOK_SECRET=random_secret_string
# ID чата/группы/канала куда бот шлёт новости (получи через @userinfobot)
TELEGRAM_BROADCAST_CHAT_ID=-1001234567890
# Telegram user ID администратора (получи через @userinfobot)
ADMIN_TG_ID=123456789

# VK
VK_COMMUNITY_TOKEN=vk1.a.xxxxx
VK_GROUP_ID=123456789
# Строка подтверждения из настроек Callback API сообщества
VK_CONFIRMATION_STRING=abc123xyz
# Секрет для верификации запросов от VK
VK_SECRET_KEY=random_vk_secret

# App
APP_BASE_URL=https://your-domain.com
# Токен для входа в веб-админку (придумай сам, минимум 32 символа)
ADMIN_SECRET_TOKEN=changeme_use_long_random_string_here
# Secure-флаг cookie логина. Включай при HTTPS-деплое, иначе оставь false.
COOKIE_SECURE=false

# Files
FILES_DIR=/app/storage/files

# Scheduler
SCHEDULER_TIMEZONE=Europe/Moscow

# Proxy (опционально, для Telegram при заблокированном прямом доступе)
# На сервере в ЕС оставь пустым — прямого доступа хватит.
PROXY_URL=
